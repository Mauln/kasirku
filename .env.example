# ──────────────────────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────────────────────
APP_NAME=Kasirku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0
GIT_COMMIT=
DEPLOY_ENV=local
DEMO_MODE=false
GUARD_RULES_ENFORCED=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ──────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kasirku_local
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ──────────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ──────────────────────────────────────────────────────────────
# SESSION & QUEUE & CACHE
# ──────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
CACHE_STORE=redis

# ──────────────────────────────────────────────────────────────
# ADAPTER DRIVERS (8)
# ──────────────────────────────────────────────────────────────
OTP_DRIVER=log
MAIL_MAILER=log
STORAGE_DRIVER=local
SUPPORT_CHAT_DRIVER=mailto
KB_DRIVER=markdown
STATUS_DRIVER=instatus
ERROR_TRACKER_DRIVER=log
PRINTER_DRIVER=log

# ──────────────────────────────────────────────────────────────
# SUPPORT URLs
# ──────────────────────────────────────────────────────────────
SUPPORT_CHAT_URL=mailto:support@kasirku.id
KB_URL=/help
STATUS_URL=https://kasirku.instatus.com

# ──────────────────────────────────────────────────────────────
# ANALYTICS
# ──────────────────────────────────────────────────────────────
ANALYTICS_ENABLED=true
ANALYTICS_QUEUE=analytics
ANALYTICS_RETENTION_DAYS=90

# ──────────────────────────────────────────────────────────────
# GUARD & EXPIRED
# ──────────────────────────────────────────────────────────────
EXPIRED_GRACE_DAYS=7
SUBSCRIPTION_REDIRECT_URL=/app/subscription

# ──────────────────────────────────────────────────────────────
# POS & AUTH
# ──────────────────────────────────────────────────────────────
POS_PIN_LOCKOUT_ATTEMPTS=5
POS_PIN_LOCKOUT_MINUTES=15
POS_DEVICE_SESSION_DAYS=30
POS_HOLD_LIMIT=10
POS_OFFLINE_CART_KEY_PREFIX=kasirku_cart_

# ──────────────────────────────────────────────────────────────
# KASBON & PROMOSI
# ──────────────────────────────────────────────────────────────
CREDIT_SALE_DEFAULT_LIMIT=500000
CREDIT_SALE_DEFAULT_DUE_DAYS=30
VOUCHER_MAX_PER_TENANT=100

# ──────────────────────────────────────────────────────────────
# STAGING (kosong, untuk Fase 7)
# ──────────────────────────────────────────────────────────────
TIDB_HOST=
TIDB_PORT=4000
TIDB_DATABASE=
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_SSL_CA=
UPSTASH_REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
RENDER_SERVICE_ID=
RENDER_API_KEY=
INSTATUS_API_KEY=
INSTATUS_PAGE_ID=
