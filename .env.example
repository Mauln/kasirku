# ==============================================================================
# KASIRKU v2.0 — Environment Template (.env.example)
# Jangan pernah commit file .env asli yang berisi kredensial/secret!
# ==============================================================================

# --- App ---
APP_NAME=Kasirku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=2.0.0-0b
GIT_COMMIT=local
DEPLOY_ENV=local
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# --- Database (MySQL 8.4 Docker Lokal) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kasirku_local
DB_USERNAME=kasirku
DB_PASSWORD=kasirku_local_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Redis 7.4 (Session, Cache, Queue) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_LIFETIME=480
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Adapter Drivers (Dev/Local Defaults) ---
OTP_DRIVER=log
FONNTE_TOKEN=
FONNTE_URL=
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kasirku.local"
MAIL_FROM_NAME="${APP_NAME}"
STORAGE_DRIVER=local
ERROR_TRACKER_DRIVER=log
SENTRY_DSN=
SUPPORT_CHAT_DRIVER=mailto
SUPPORT_CHAT_URL="mailto:support@kasirku.id"
KB_DRIVER=markdown
KB_URL="/help"
STATUS_DRIVER=instatus
STATUS_URL="https://kasirku.instatus.com"
PRINTER_DRIVER=log

# --- Guard Rules & Subscription ---
GUARD_RULES_ENFORCED=false
FORCE_HTTPS=false
TELESCOPE_ENABLED=false
EXPIRED_GRACE_DAYS=7
SUBSCRIPTION_REDIRECT_URL="/app/subscription?reason=expired"

# --- Reference Seeder (Optional override, jangan isi secret production di repo) ---
SEED_ADMIN_EMAIL=superadmin@kasirku.local
SEED_ADMIN_PASSWORD=

# --- Analytics ---
ANALYTICS_ENABLED=true
ANALYTICS_QUEUE=analytics
ANALYTICS_RETENTION_DAYS=90

# --- POS, PIN & Hold Order ---
POS_PIN_LOCKOUT_ATTEMPTS=5
POS_PIN_LOCKOUT_MINUTES=15
POS_DEVICE_SESSION_DAYS=30
POS_HOLD_LIMIT=10
POS_OFFLINE_CART_KEY_PREFIX=kasirku_cart_

# --- Kasbon & Promosi ---
CREDIT_SALE_DEFAULT_LIMIT=500000
CREDIT_SALE_DEFAULT_DUE_DAYS=30
VOUCHER_MAX_PER_TENANT=100

# --- AI Studio Runtime Secrets (Injected via AI Studio Secrets Panel) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
